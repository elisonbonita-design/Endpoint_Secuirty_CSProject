# Lab server settings, read at startup (python -m webapp). Copy to instance/app.env.
# Keep instance/ private: never commit, share or upload app.env.
#
# Listen on the lab address so WS01 can reach SEC01 (paper: https://10.20.0.20:8443).
# Any address other than 127.0.0.1 requires TLS_CERT and TLS_KEY.
APP_HOST=127.0.0.1
APP_PORT=5000
TLS_CERT=
TLS_KEY=
# Set to 1 when serving over HTTPS so the session cookie is only sent over TLS.
SESSION_COOKIE_SECURE=0
# Shared secret for the BitLocker collector (32+ random characters, for example from
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ). Leave empty to keep the collector endpoint off.
COLLECTOR_TOKEN=
