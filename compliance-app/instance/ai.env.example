# Optional local AI (Ollama) settings, read by the server at startup (python -m webapp).
# Copy this file to instance/ai.env to use it. Environment variables take precedence.
# The AI only writes explanations; priority always comes from the rule-based score.
# AI_BASE_URL must be 127.0.0.1, localhost or an address in 10.20.0.0/24 (offline lab).

AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:3b
AI_TIMEOUT_SECONDS=20
